extends Node
## 本棚の本を読む（自室の右の壁一面の本棚）。装飾と読み物のみ。取得・暗証番号・脱出条件には使わない。
##   表紙を見せた本15冊（book_cover_01〜15）… 狙ってクリックすると、表紙と短い3ページの文章を読める
##   背表紙の本（約390冊）… 棚の段ごとの判定。狙った位置の1冊分（段と横位置から決まる）の題名と一節を読める
## 読むと本の画面（hud.gd の show_reader）が開く。左クリックで次のページ・最後の次で閉じる。Esc でも閉じる（main.gd）。
## 文章は短い一節で、謎の手がかりではない（石・椅子・窓・猫など、この部屋の物の雰囲気を借りた掌編）。

signal read_requested(title: String, pages: Array, cover: Texture2D, tint: Color)

const COVER_DIR := "res://assets/textures/books/book_cover_%02d.png"
const SPINE_BUCKET := 0.1    # 背表紙の本を選ぶ横幅（m）

var player: Node3D   # main.gd が渡す。照準の当たった位置（段・横位置）を調べる
var shelf_step := 1.18 / 4.0
var shelf_z0 := -0.2   # 本棚の端（z）。apartment.gd が渡す
var levels := 4         # 本棚の段の数

