func get_prompt(_id: String) -> String:
	return "book_read"


func interact(id: String) -> String:
	if id.begins_with("book_"):
		var n := int(id.substr(5))
		var b: Array = COVERS[n]
		read_requested.emit(b[0], b[1], load(COVER_DIR % n), Color.WHITE)
		return ""
	# 背表紙の本：照準の当たった位置から段と横位置を決める（同じ場所は同じ本）
	var p := Vector3.ZERO
	if player and player.get("ray"):
		p = player.ray.get_collision_point()
	var level := clampi(int(p.y / shelf_step), 0, levels - 1)
	var bucket := maxi(0, int((p.z - shelf_z0) / SPINE_BUCKET))
	var s: Array = SPINES[posmod(level * 11 + bucket * 7, SPINES.size())]
	var h := float(posmod(level * 53 + bucket * 29, 100)) / 100.0
	var tint := Color.from_hsv(h, 0.35, 0.55)
	read_requested.emit(s[0], [s[1]], null, tint)
	return ""
